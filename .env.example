# Every variable the code reads. Blank means the default in README.md applies.
# server.py loads this file itself; the CLI and bridge need `set -a; . ./.env; set +a`.

# Canned results from the fixtures instead of a model call. Default: true.
BEDROCK_MOCK=
# Bedrock model or inference profile id. Default: us.anthropic.claude-sonnet-4-6
BEDROCK_MODEL_ID=
# Bedrock region. Default: us-east-2
AWS_REGION=

# Server port. Default: 8001
PORT=
# Requests per client per window on /triage and /mcp. Defaults: 20 per 3600 seconds.
RATE_LIMIT_REQUESTS=
RATE_LIMIT_WINDOW_SECONDS=
# Comma-separated browser origins. Default: http://localhost:8080
CORS_ORIGINS=
# MCP DNS-rebinding allowlists, comma-separated. Default: localhost only.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# Intercom sandbox access token from the developer hub. Never commit the real one.
INTERCOM_ACCESS_TOKEN=
# Optional. If unset, the bridge asks /me for the token's admin id.
INTERCOM_ADMIN_ID=

# n8n instance-level MCP access token: Settings > Instance-level MCP > Connect > API key tab.
# Used by n8n/mcp.py. The n8n public API key does not work here.
N8N_MCP_TOKEN=
# Where n8n lives. Default: http://localhost:5678. The hosted demo sets the Render URL.
N8N_URL=
# Id of the "Triage Intercom EDI ticket" workflow on that instance. Default: the local one.
N8N_WORKFLOW_ID=

# Intercom app client secret (Developer Hub > app > Basic information). n8n verifies
# X-Hub-Signature with it; n8n/fire-webhook.py signs the demo webhook with it.
INTERCOM_CLIENT_SECRET=

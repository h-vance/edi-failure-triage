# Intercom sandbox access token from the developer hub. Never commit the real one.
INTERCOM_ACCESS_TOKEN=
# Optional. If unset, the bridge asks /me for the token's admin id.
INTERCOM_ADMIN_ID=

# n8n instance-level MCP access token: Settings > Instance-level MCP > Connect > API key tab.
# Used by n8n/mcp.py. The n8n public API key does not work here.
N8N_MCP_TOKEN=

# Intercom app client secret (Developer Hub > app > Basic information). n8n verifies
# X-Hub-Signature with it; n8n/fire-webhook.py signs the demo webhook with it.
INTERCOM_CLIENT_SECRET=
